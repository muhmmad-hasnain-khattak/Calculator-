<resources>
    <style name="CalcBaseButtonStyle" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Unified Professional Color Theme Styles -->
    <style name="CalcNumButtonStyle" parent="CalcBaseButtonStyle">
        <item name="backgroundTint">#1E293B</item>
        <item name="android:textColor">#F8FAFC</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="CalcSciButtonStyle" parent="CalcBaseButtonStyle">
        <item name="backgroundTint">#1E293B</item>
        <item name="android:textColor">#38BDF8</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="CalcOpButtonStyle" parent="CalcBaseButtonStyle">
        <item name="backgroundTint">#334155</item>
        <item name="android:textColor">#38BDF8</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcActionButtonStyle" parent="CalcBaseButtonStyle">
        <item name="backgroundTint">#0F172A</item>
        <item name="android:textColor">#FB7185</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CalcEqualsButtonStyle" parent="CalcBaseButtonStyle">
        <item name="backgroundTint">#0284C7</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
